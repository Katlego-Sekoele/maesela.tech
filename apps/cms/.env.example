# Neon Postgres (provided by the Vercel Neon integration in production)
DATABASE_URL=postgresql://user:password@host/db?sslmode=require
# Payload encryption secret (generate a strong random value; set in Vercel)
PAYLOAD_SECRET=change-me
# Vercel Blob (image hosting)
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxx
