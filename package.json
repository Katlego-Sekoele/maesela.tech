{
  "name": "maesela-monorepo",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.5.3",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "web": "pnpm --filter @maesela/web",
    "cms": "pnpm --filter @maesela/cms",
    "build": "nx run-many -t build",
    "dev": "nx run-many -t dev --parallel=2"
  },
  "devDependencies": {
    "nx": "^21.0.0"
  }
}
